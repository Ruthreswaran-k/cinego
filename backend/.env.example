PORT=3000
NODE_ENV=development

# Oracle Database
ORACLE_USER=cinego_user
ORACLE_PASSWORD=cinego_pass
ORACLE_CONNECTION_STRING=localhost:1522/XEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:5173

# Real SMS Gateway (Leave empty to use Dev Simulator)
# Option 1: Fast2SMS (Fastest & most popular for India: fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Option 2: Twilio (International SMS: twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
